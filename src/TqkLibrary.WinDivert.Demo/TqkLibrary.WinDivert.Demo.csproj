<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\ProjectBuildProperties.targets" />

	<PropertyGroup>
		<!-- The demo pulls TqkLibrary.Proxy, which needs Microsoft.Extensions.* 10.x — and those do not
		     support net6.0. The libraries themselves still target both. -->
		<TargetFrameworks>net8.0-windows</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>TqkLibrary.WinDivert.Demo</RootNamespace>
		<AssemblyName>TqkLibrary.WinDivert.Demo</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x64;x86</Platforms>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\TqkLibrary.WinDivert.Redirect\TqkLibrary.WinDivert.Redirect.csproj" />
		<ProjectReference Include="..\TqkLibrary.WinDivert.ProcessControl\TqkLibrary.WinDivert.ProcessControl.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="System.CommandLine" />
	  <PackageReference Include="TqkLibrary.Proxy" />
	  <PackageReference Include="Microsoft.Extensions.Logging" />
	</ItemGroup>

</Project>
